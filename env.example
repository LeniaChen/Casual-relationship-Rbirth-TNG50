# Local settings for the helper scripts in tools/ (copy to .env and edit; .env is git-ignored).
#
# Python interpreter of the analysis environment (numpy/scipy/pandas/h5py/matplotlib; AGAMA optional)
PY=python3
# Python interpreter of the RLCD environment (Python 3.12 + requirements-rlcd.txt); may be the same as PY
PY_RLCD=python3
# Folder that holds the full (non-public) data with the same layout as this repo; only needed for tools/link_data.sh
RBIRTH_DATA_ROOT=
#
# Example (two virtual environments in the repo + full data on an external disk):
# PY=.venv/bin/python3
# PY_RLCD=.venv-rlcd/bin/python3
# RBIRTH_DATA_ROOT=/Volumes/MyDisk/rbirth-tng50-data
