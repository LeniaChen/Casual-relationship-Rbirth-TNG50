# ===== Large data: not in Git (tens of MB to 1 GB per file, ~17 GB in total) =====
# On a machine with the full data these paths are symbolic links made by tools/link_data.sh,
# so the patterns have no trailing "/" (Git treats a symlink as a file). See DATA.md, data_manifest.tsv.
*.hdf5
/data/tng50_extract
/data/tng50_derived/orbits_all.hdf5
/data/tng50_derived/orbits_test.hdf5
/data/rlcd_input/nonoise
/data/rlcd_input/noise
/PlanB/input_data/nonoise
/PlanB/input_data/noise
/PlanB/true_value
/star_condition/*/input_data/nonoise
/star_condition/*/input_data/noise
/star_condition/*/true_value
/legacy

# ===== The authors' RLCD repository: cloned or linked by tools/setup_rlcd_repo.sh / link_data.sh =====
/Causal-Galactic-Archaeology

# ===== Paper PDF (copyright): keep locally only =====
/docs/paper

# ===== Local settings and environments =====
.env
.venv*/
venv*/

# ===== OS / Python / editor clutter =====
.DS_Store
__pycache__/
*.pyc
.ipynb_checkpoints/
.vscode/
.idea/
*.swp
